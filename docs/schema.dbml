// Apple Gift Cards store — ER model (PostgreSQL)
// Visualize: https://dbdiagram.io

Project apple_gift_cards {
  database_type: 'PostgreSQL'
  Note: 'Data model — users, orders, gift_cards, prices, subscriptions'
}

Enum order_status {
  pending_payment
  paid
  completed
  cancelled
}

Enum gift_card_status {
  available
  reserved
  sold
  blocked
}

Enum subscription_status {
  active
  past_due
  cancelled
}

Table users {
  id bigint [pk, increment, note: 'GENERATED BY DEFAULT AS IDENTITY']
  email varchar(254) [unique, not null]
  created_at timestamptz [not null, default: `now()`]
}

Table prices {
  nominal_usd smallint [pk, note: 'CHECK: IN (1,2,3,4,5,10,15,20,25,30,40,50,100,200)']
  price_rub decimal(12, 2) [not null, note: 'CHECK: price_rub > 0']
}

Table orders {
  id bigint [pk, increment]
  user_id bigint [not null]
  status order_status [not null, default: 'pending_payment']
  items jsonb [not null, note: 'Non-empty array. Example: [{"nominal_usd":10,"quantity":2,"price_rub":1000.00}]']
  total_amount_rub decimal(12, 2) [not null, note: 'CHECK: total_amount_rub > 0']
  reserved_until timestamptz [not null, default: `now() + interval '15 minutes'`]
  paid_at timestamptz
  email_sent_at timestamptz
  created_at timestamptz [not null, default: `now()`]

  indexes {
    user_id
    (status, reserved_until)
  }
}

Table gift_cards {
  id bigint [pk, increment]
  nominal_usd smallint [not null]
  code_encrypted bytea [not null]
  status gift_card_status [not null, default: 'available']
  order_id bigint
  sale_price_rub decimal(12, 2)
  created_at timestamptz [not null, default: `now()`]

  indexes {
    (nominal_usd, status)
    order_id
  }

  Note: '''
  CHECK constraint:
  - reserved/sold → order_id NOT NULL, sale_price_rub NOT NULL and > 0
  - available/blocked → order_id NULL, sale_price_rub NULL
  '''
}

Table subscriptions {
  id bigint [pk, increment, note: 'GENERATED BY DEFAULT AS IDENTITY']
  user_id bigint [not null]
  nominal_usd smallint [not null]
  payment_method_id varchar(64) [not null, note: 'CHECK: char_length(btrim(payment_method_id)) > 0']
  status subscription_status [not null, default: 'active']
  next_billing_at timestamptz [not null]
  dunning_attempts smallint [not null, default: 0, note: 'CHECK: dunning_attempts >= 0']
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null, default: `now()`]

  indexes {
    user_id [name: 'ix_subscriptions_user_id']
    (status, next_billing_at) [name: 'ix_subscriptions_status_next_billing_at']
  }
}

Ref: orders.user_id > users.id [delete: restrict]

Ref: subscriptions.user_id > users.id [delete: restrict]

Ref: subscriptions.nominal_usd > prices.nominal_usd [delete: restrict]

Ref: gift_cards.nominal_usd > prices.nominal_usd [delete: restrict]

Ref: gift_cards.order_id > orders.id [delete: restrict]
