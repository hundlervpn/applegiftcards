meta {
  name: 20 Cancelled subscription in account
  type: http
  seq: 20
}

get {
  url: {{baseUrl}}/api/v1/me/subscriptions
  body: none
  auth: none
}

headers {
  Accept: application/json
  Authorization: Bearer {{authToken}}
}

tests {
  const get = key => bru.getVar(key) ?? bru.getEnvVar(key);
  const set = (key, value) => bru.setVar(key, value);
  const next = name => bru.runner.setNextRequest(name);
  test("20 Cancelled subscription in account", function () {
    try {
      const status = res.getStatus();
      expect(status).to.equal(200);
      const body = res.getBody();
      expect(body.subscriptions).to.have.lengthOf(1);
      expect(String(body.subscriptions[0].id)).to.equal(String(get('testSubscriptionId')));
      expect(body.subscriptions[0].status).to.equal('cancelled');
    } catch (error) {
      next(null);
      throw error;
    }
  });
}

docs {
  20 Cancelled subscription in account
}

example {
  name: 200 OK

  request: {
    url: {{baseUrl}}/api/v1/me/subscriptions
    method: GET
    headers: {
      Accept: application/json
      Authorization: Bearer {{authToken}}
    }
  }

  response: {
    headers: {
      Content-Type: application/json
    }

    status: {
      code: 200
      text: OK
    }

    body: {
      type: json
      content: '''
        {
          "subscriptions": [
            {
              "id": 42,
              "nominal_usd": 10,
              "status": "cancelled",
              "card_mask": "**** 4242",
              "next_billing_at": "2026-11-25T12:00:00Z",
              "price_rub": "999.00",
              "created_at": "2026-10-26T12:00:00Z"
            }
          ]
        }
      '''
    }
  }
}
