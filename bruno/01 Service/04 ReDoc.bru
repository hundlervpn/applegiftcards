  const next = name => bru.runner.setNextRequest(name);
  test("04 ReDoc", function () {
    try {
      const status = res.getStatus();
      expect(status).to.equal(200);
      const body = res.getBody();
      expect(body).to.include('redoc');
    } catch (error) {
      next(null);
      throw error;
    }
  });
}

