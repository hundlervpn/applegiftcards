meta {
  name: 30 My support tickets
  type: http
  seq: 30
}

get {
  url: {{baseUrl}}/api/v1/support/tickets
  body: none
  auth: none
}

headers {
  Accept: application/json
  Authorization: Bearer {{authToken}}
}

tests {
  const get = key => bru.getVar(key) ?? bru.getEnvVar(key);
  const set = (key, value) => bru.setVar(key, value);
  const next = name => bru.runner.setNextRequest(name);
  test("30 My support tickets", function () {
    try {
      const status = res.getStatus();
      const body = res.getBody();
      expect(status).to.equal(200);
      expect(body.total).to.be.at.least(1);
      const ticket = body.tickets.find(item => item.id === Number(get('testSupportTicketId')));
      expect(ticket).to.be.an('object');
      expect(ticket.status).to.equal('open');
    } catch (error) {
      next(null);
      throw error;
    }
  });
}

docs {
  Только собственные обращения и их статусы.
}

example {
  name: 200 OK

  request: {
    url: {{baseUrl}}/api/v1/support/tickets
    method: GET
    headers: {
      Accept: application/json
      Authorization: Bearer {{authToken}}
    }
  }

  response: {
    headers: {
      Content-Type: application/json
    }

    status: {
      code: 200
      text: OK
    }

    body: {
      type: json
      content: '''
        {
          "tickets": [
            {
              "id": 1,
              "order_id": 123,
              "subject": "Код не активируется",
              "message": "При активации подарочной карты появляется ошибка. Прошу проверить заказ.",
              "status": "open",
              "created_at": "2026-11-05T12:00:00Z"
            }
          ],
          "total": 1
        }
      '''
    }
  }
}
